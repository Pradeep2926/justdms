NODE_ENV=production
HOST=0.0.0.0
PORT=5001

FRONTEND_URL=https://justdms.in

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://api.justdms.in/auth/meta/callback

# Instagram API with Instagram Login (no Facebook Page required).
# These may use the same Meta app credentials when that app has the
# Instagram API with Instagram Login use case configured.
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=https://api.justdms.in/auth/instagram/callback

INSTAGRAM_VERIFY_TOKEN=justdms_verify_token
JWT_SECRET=replace-with-a-long-random-secret

# Do not set BACKEND_STORAGE=local in production.
